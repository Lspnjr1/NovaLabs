# Dependency Confusion Mitigation
# Explicitly set registry to official npm to prevent supply-chain attacks
# See: https://github.com/ossillate-inc/security-advisories/security/advisories/GHSA-7p7v-2gqg-qmj2

registry=https://registry.npmjs.org/

# Reject packages from unknown registries
# This prevents dependency confusion attacks where attackers publish
# internal package names to public registries
@*:registry=https://registry.npmjs.org/
